# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API (your Wayfare frontend, this AI planner's frontend, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM provider ---
# Which provider aiPlannerService should use. Swap without touching calling code.
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Wayfare integration ---
# Base URL of the Trip Feasibility Engine, used only if this service ever needs to
# re-validate a modified trip itself instead of letting the frontend call it directly.
FEASIBILITY_ENGINE_URL=http://localhost:8080/api/feasibility

# Supabase (only needed if this service reads/writes trip data directly instead of
# receiving it fully-formed from the feasibility engine)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
